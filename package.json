{
  "name": "nakara",
  "version": "0.1.0",
  "description": "Self-hosted software factory: issues in, reviewed draft PRs out.",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "vite",
    "validate": "node src/cli/validate.ts",
    "restore": "node src/cli/restore.ts",
    "downgrade": "node src/cli/downgrade.ts",
    "seed": "node src/cli/seed.ts",
    "scaffold": "node src/cli/scaffold.ts",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "check": "biome check . && node --test scripts/check-boundaries.test.ts",
    "dev:server": "node --watch src/main.ts",
    "build": "vite build",
    "test:web": "vitest run",
    "pretest:smoke": "npm run build",
    "test:smoke": "playwright test",
    "ci": "npm run build && npm run check && npm run typecheck && npm test && npm run test:web && npm run test:smoke"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/color-name": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "color-name": "^2.1.1",
    "postcss": "^8.5.31",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "private": true
}
